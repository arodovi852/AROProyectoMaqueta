# ======================================
# BROADCASTTD Backend - Environment Variables
# ======================================
# Copia este archivo a .env y configura los valores

# ======================================
# SERVIDOR
# ======================================
PORT=3000
NODE_ENV=development

# ======================================
# JWT (JSON Web Token)
# ======================================
# ⚠️ CAMBIAR EN PRODUCCIÓN - Usar un valor largo y aleatorio
# Ejemplo: openssl rand -base64 64
JWT_SECRET=tu-clave-secreta-muy-segura-cambiar-en-produccion-usar-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# ======================================
# BASE DE DATOS
# ======================================
# PostgreSQL (ejemplo)
DATABASE_URL=postgresql://usuario:password@localhost:5432/broadcasttd

# MySQL (alternativa)
# DATABASE_URL=mysql://usuario:password@localhost:3306/broadcasttd

# MongoDB (alternativa)
# DATABASE_URL=mongodb://localhost:27017/broadcasttd

# ======================================
# CORS
# ======================================
# Lista de orígenes permitidos separados por comas
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# ======================================
# RATE LIMITING
# ======================================
# Ventana de tiempo en milisegundos (15 minutos = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
# Máximo de peticiones por ventana
RATE_LIMIT_MAX_REQUESTS=100

# ======================================
# LOGGING
# ======================================
# Niveles: error, warn, info, http, debug
LOG_LEVEL=info

# ======================================
# PAGINACIÓN
# ======================================
# Número de elementos por página por defecto
DEFAULT_PAGE_SIZE=20
# Máximo de elementos por página
MAX_PAGE_SIZE=100

# ======================================
# ARCHIVOS Y UPLOADS (opcional)
# ======================================
# UPLOAD_MAX_FILE_SIZE=5242880  # 5MB en bytes
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ======================================
# EMAILS (opcional)
# ======================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-password-de-aplicacion

# ======================================
# REDIS (opcional - para caché)
# ======================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ======================================
# TERCEROS (opcional)
# ======================================
# API keys para servicios externos
# TMDB_API_KEY=tu-api-key-de-tmdb
# IMDB_API_KEY=tu-api-key-de-imdb
