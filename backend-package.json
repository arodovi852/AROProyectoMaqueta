{
  "name": "broadcasttd-backend",
  "version": "1.0.0",
  "description": "Backend API REST para BROADCASTTD - Plataforma de seguimiento de series",
  "main": "dist/backend/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/backend/server.ts",
    "build": "tsc -p tsconfig.backend.json",
    "start": "node dist/backend/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/backend --ext .ts",
    "lint:fix": "eslint src/backend --ext .ts --fix",
    "format": "prettier --write \"src/backend/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/backend/seeds/seed.ts"
  },
  "keywords": [
    "typescript",
    "express",
    "api",
    "rest",
    "jwt",
    "series",
    "tracking"
  ],
  "author": "Alberto Rodríguez Oviedo",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
